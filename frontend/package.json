{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:deployment-config": "node --test hosting-config.test.mjs",
    "test:deployment": "playwright test --config=playwright.deployment.config.ts",
    "test:assignment-config": "node --test assignment-hosting-config.test.mjs",
    "test:assignment": "playwright test --config=playwright.assignment.config.ts",
    "test:public-config": "node --test public-hosting-config.test.mjs",
    "test:public": "playwright test --config=playwright.public.config.ts"
  },
  "dependencies": {
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  }
}

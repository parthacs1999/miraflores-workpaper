# LOCAL DEVELOPMENT (default when the variable is absent):
NEXT_PUBLIC_API_URL=http://localhost:8000
# HOSTED PRODUCTION: replace the line above with an explicitly EMPTY value:
# NEXT_PUBLIC_API_URL=
# WORKPAPER_HOSTED=1
# WORKPAPER_PUBLIC_ORIGIN=https://workpaper.YOUR-DOMAIN.example
# WORKPAPER_BACKEND_ORIGIN=https://YOUR-SERVICE.onrender.com
# No identity-provider secrets or session credentials belong in NEXT_PUBLIC_*.

# Explicit LOCAL production-bundle preview only (never set on Vercel):
# WORKPAPER_LOCAL_BUILD=1

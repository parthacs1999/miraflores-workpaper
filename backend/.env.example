# Configuration reference. The launcher does NOT automatically load dotenv files.
# LOCAL: run `python run_secure.py --demo` with no conflicting WORKPAPER_ENV/MODE.
# Optional separate local database:
# REVIEW_DB_PATH=/absolute/path/outside/repository/local-demo.db

# HOSTED: set these in Render, not in Git. Replace every placeholder.
WORKPAPER_ENV=production
WORKPAPER_MODE=access
WORKPAPER_ORIGINS=https://workpaper.YOUR-DOMAIN.example
WORKPAPER_ACCESS_ISSUER=https://YOUR-TEAM.cloudflareaccess.com
WORKPAPER_ACCESS_AUDIENCE=REPLACE_WITH_ACCESS_APPLICATION_AUDIENCE
WORKPAPER_ACCESS_STAFF={"REPLACE_WITH_VERIFIED_ACCESS_USER_SUBJECT":"st-01"}
WORKPAPER_DISK_ROOT=/var/data
REVIEW_DB_PATH=/var/data/workpaper.db
WEB_CONCURRENCY=1
# Render supplies PORT. No shared credential fallback is permitted in access mode.
# WORKPAPER_CREDENTIALS must remain unset.

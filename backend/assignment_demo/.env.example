# NON-PRODUCTION. This file is a reference; the launcher does not load dotenv files.
WORKPAPER_PROFILE=assignment-demo
WORKPAPER_ENV=production
WEB_CONCURRENCY=1
WORKPAPER_ORIGINS=https://YOUR-ASSIGNMENT.vercel.app
WORKPAPER_ASSIGNMENT_EXPIRES_AT=REPLACE_WITH_UTC_TIMESTAMP_WITHIN_SEVEN_DAYS
WORKPAPER_ASSIGNMENT_REVIEWERS={"st-01":"REPLACE_WITH_64_HEX_SHA256_OF_PRIVATE_RANDOM_TOKEN"}
WORKPAPER_ASSIGNMENT_PACKET_SHA256=REPLACE_AFTER_REVIEWING_INSTRUCTIONS_JSON
WORKPAPER_ASSIGNMENT_SEED_SHA256=REPLACE_AFTER_REVIEWING_SEED_JSON
WORKPAPER_ASSIGNMENT_DATA_APPROVAL=DO_NOT_SET_UNTIL_SANITIZATION_AND_SHARING_RIGHTS_REVIEWED
# Deliberately unset: REVIEW_DB_PATH, WORKPAPER_DISK_ROOT, WORKPAPER_CREDENTIALS,
# WORKPAPER_HOSTED, WORKPAPER_MODE. Never use historical reviews.db as a seed.
